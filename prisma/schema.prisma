generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WAITLISTED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  FEE
  GRADE
  ATTENDANCE
}

// ============================================
// CORE AUTHENTICATION
// ============================================

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       Student?
  parent        Parent?
  teacher       Teacher?
  notifications Notification[]
}

// ============================================
// STUDENT MANAGEMENT
// ============================================

model Student {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  gradeLevel   String
  rollNumber   String          @unique
  dateOfBirth  DateTime?
  phone        String?
  address      String?
  profileImage String?
  createdAt    DateTime        @default(now())
  grades       Grade[]
  fees         Fee[]
  attendance   Attendance[]
  parentLinks  ParentStudent[]

  @@index([gradeLevel])
}

model Parent {
  id         String          @id @default(cuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String?
  occupation String?
  createdAt  DateTime        @default(now())
  children   ParentStudent[]
}

model ParentStudent {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String? // "Father", "Mother", "Guardian"
  parent       Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// ============================================
// STAFF MANAGEMENT
// ============================================

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  subject       String
  qualification String?
  bio           String?
  profileImage  String?
  createdAt     DateTime @default(now())
  classes       Class[]
}

model Staff {
  id          String   @id @default(cuid())
  name        String
  email       String
  department  String
  designation String
  bio         String?
  image       String?
  phone       String?
  order       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([department])
  @@index([isPublic, order])
}

// ============================================
// ACADEMIC RECORDS
// ============================================

model Class {
  id           String       @id @default(cuid())
  name         String
  grade        String
  section      String
  subject      String
  academicYear String       @default("2025-2026")
  teacherId    String
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  grades       Grade[]
  attendance   Attendance[]

  @@index([grade, section])
}

model Grade {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  subject        String
  assessmentName String   @default("Assessment")
  score          Float
  maxScore       Float    @default(100)
  grade          String
  term           String
  year           Int
  remarks        String?
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class    @relation(fields: [classId], references: [id])
  createdAt      DateTime @default(now())

  @@index([studentId, term, year])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([studentId, classId, date])
  @@index([studentId, date])
}

// ============================================
// FINANCIAL RECORDS
// ============================================

model Fee {
  id               String    @id @default(cuid())
  studentId        String
  amount           Float
  description      String
  dueDate          DateTime
  status           FeeStatus @default(PENDING)
  paidAmount       Float     @default(0)
  paidAt           DateTime?
  stripePaymentId  String?
  stripeSessionId  String?
  term             String?
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([studentId, status])
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  category    String    @default("General")
  coverImage  String?
  author      String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  category    String?
  isPublic    Boolean   @default(true)
  isAllDay    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([startDate])
  @@index([isPublic, startDate])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String?
  link      String?
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive, priority])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String // "Parent", "Student", "Alumni"
  content   String
  image     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, order])
}

model Newsletter {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}

// ============================================
// APPLICATIONS
// ============================================

model Application {
  id                 String            @id @default(cuid())
  applicationNumber  String            @unique @default(cuid())
  status             ApplicationStatus @default(PENDING)
  gradeApplying      String
  academicYear       String            @default("2025-2026")
  studentFirstName   String
  studentLastName    String
  studentDob         DateTime
  studentGender      String
  previousSchool     String?
  guardianFirstName  String
  guardianLastName   String
  guardianEmail      String
  guardianPhone      String
  guardianRelation   String
  guardianOccupation String?
  guardianAddress    String
  documents          Json?
  notes              String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
}

// ============================================
// COMMUNICATION
// ============================================

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  repliedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ============================================
// SITE CONFIGURATION
// ============================================

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}
